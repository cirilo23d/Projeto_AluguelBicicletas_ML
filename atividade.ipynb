   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "\n",
    "x = [[10],[15],[20],[25],[35],[40],[50],[55],[60]]\n",
    "y = [10, 13, 14, 18, 19, 23, 24, 30, 32, 34]\n",
    "\n",
    "modelo = LinearRegression()\n",
    "\n",
    "modelo.fit(x,y)\n",
    "\n",
    "valor_pago = modelo.predict([[45]])\n",
    "\n",
    "print(f\"lucro em 45 minutos: R$ {valor_pago[0]:,.2f}\")"
   ]
  }
